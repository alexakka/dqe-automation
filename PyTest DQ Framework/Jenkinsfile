// Dedicated DQ pipeline for "PyTest DQ Framework" (separate from data_dev).
// Job type: Pipeline, "Pipeline script from SCM", Script Path = "PyTest DQ Framework/Jenkinsfile".
// Prerequisites: data_dev already produced /parquet_data/<dataset>, and a Jenkins
// "Username with password" credential with ID POSTGRES_SECRET (Postgres user/password).
pipeline {
    agent any

    environment {
        // exposes POSTGRES_SECRET_USR and POSTGRES_SECRET_PSW (values are masked in the console log)
        POSTGRES_SECRET = credentials('POSTGRES_SECRET')
        DQ_DIR = 'PyTest DQ Framework'
    }

    stages {
        stage('Update Packages') {
            steps {
                sh 'apt-get update'
                // libpq-dev + gcc + python3-dev are needed to build psycopg2
                sh 'apt-get install -y libpq-dev gcc python3 python3-dev python3-pip python3-venv'
            }
        }
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Install Dependencies') {
            steps {
                dir("${env.DQ_DIR}") {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }
        stage('Run DQ Tests') {
            steps {
                // Failed checks are findings, not a broken build: keep the job SUCCESS,
                // mark only this stage FAILURE. The HTML report is the evidence.
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    dir("${env.DQ_DIR}") {
                        sh '''
                            . venv/bin/activate
                            export PYTHONPATH="$PWD"
                            pytest tests -m "parquet_data" \
                                --db_host="postgres" \
                                --db_port="5432" \
                                --db_name="mydatabase" \
                                --db_user="$POSTGRES_SECRET_USR" \
                                --db_password="$POSTGRES_SECRET_PSW" \
                                --html=html_report/report.html --self-contained-html
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            // Archive the entire html_report directory (open report.html from the build's Artifacts).
            // No HTML Publisher plugin needed: the report is self-contained.
            archiveArtifacts artifacts: 'PyTest DQ Framework/html_report/**', allowEmptyArchive: true
        }
    }
}